# Copy to .env (repo root or play-to-spring-kit/ — find_dotenv() walks up
# from cwd either way) and fill in real values.
#
# LangGraph engine (default): agent/config.py calls load_dotenv() at import,
# so this file loads automatically — no manual export needed.
#
# Legacy engine (scripts/migration_orchestrator.py): still reads plain
# os.environ, does NOT auto-load this file — export vars yourself
# (`export $(grep -v '^#' .env | xargs)`) or via direnv/shell profile.

# --- LangGraph engine (default, MIGRATION_ENGINE=langgraph) ---------------

# Required for any LLM round (bootstrap, compile-fix, routes, config-mapping,
# runtime-wiring). Without it, deterministic fixers still run; LLM-gated
# phases resolve to no_llm/skip gracefully instead of crashing.

OPENROUTER_API_KEY=sk-dssd


# Any OpenAI-compatible endpoint works.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model tiers: cheap first, escalate to premium after ESCALATE_AFTER_RETRIES.
# MIGRATION_MODEL_CHEAP=anthropic/claude-haiku-4.5
# MIGRATION_MODEL_PREMIUM=anthropic/claude-sonnet-4.5

# LLM_TIMEOUT_SEC=600
# MAX_TOTAL_LLM_CALLS=50
# MAX_RETRIES_PER_LAYER=5
# TIMEOUT_PER_LAYER_MINS=30
# ESCALATE_AFTER_RETRIES=2
# MAX_AGENT_TOOL_CALLS=8

# --- Engine selection -------------------------------------------------------

# langgraph (default) | legacy
# MIGRATION_ENGINE=langgraph

# --- start_upgrade.sh convenience vars -------------------------------------

# PLAY_REPO=/path/to/your-play-app
# MIGRATION_WORKSPACE=/path/to/isolated-workspace
# MIGRATION_SKIP_VENV_SYNC=1   # skip pip install, reuse an already-provisioned .venv

# --- Legacy engine only (--engine legacy / MIGRATION_ENGINE=legacy) -------

# CURSOR_API_KEY=...   # headless cursor-agent init/compile-fix rounds
